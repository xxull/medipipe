# 主模型 Key（可选，框架 B 不配也能用）
MY_LLM_KEY=

# HuggingFace token（下载门控数据集时需要）
HF_TOKEN=

# ---- 下面都可以不填，默认就够用 ----

# 数据库位置（默认 data/records.db）
# FW_DB=D:\path\to\records.db

# Ollama 地址与模型目录
# FW_OLLAMA_BASE=http://127.0.0.1:11434
# FW_OLLAMA_STORE=D:\ollama\models

# 额外的模型文件目录（扫 .gguf / .safetensors 用，多个用分号隔开）
# FW_MODEL_DIR=D:\models

# 单步超时（秒，默认 180）
# FW_STEP_TIMEOUT=180
